{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run check-types",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@effect/platform": "^0.95.0",
    "@effect/platform-node": "^0.105.0",
    "@effect/schema": "^0.75.5",
    "@effect/sql": "^0.50.0",
    "@effect/sql-mysql2": "^0.51.0",
    "@hono/trpc-server": "^0.4.2",
    "@OpenWord/api": "*",
    "@OpenWord/auth": "*",
    "@OpenWord/db": "*",
    "@OpenWord/env": "*",
    "@trpc/server": "^11.13.4",
    "better-auth": "^1.5.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "effect": "^3.19.14",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "nodemailer": "^6.10.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.8.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@effect/vitest": "^0.28.0",
    "@OpenWord/config": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^6.4.17",
    "@vitest/coverage-v8": "^3.1.1",
    "@vitest/ui": "^3.1.1",
    "jsdom": "^26.0.0",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.16.5",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.1.1"
  }
}
